{
    "name": "bakewizard/bakekit",
    "description": "A CakePHP 5-based web application starter kit",
    "license": "MIT",
    "type": "project",
    "homepage": "https://github.com/bakewizard/bakekit",
    "keywords": [
        "php",
        "cakephp",
        "cms",
        "starter",
        "boilerplate",
        "admin-panel",
        "bake"
    ],
    "require": {
        "php": ">=8.3",
        "admad/cakephp-sequence": "^4.0",
        "cakephp/authentication": "^3.3",
        "cakephp/authorization": "^3.4",
        "cakephp/cakephp": "5.3.*",
        "cakephp/migrations": "^5.0.0",
        "cakephp/plugin-installer": "^2.0",
        "friendsofcake/bootstrap-ui": "^5.1",
        "friendsofcake/search": "^7.7",
        "imagine/imagine": "^1.5",
        "k-samuel/faceted-search": "^3.2",
        "league/flysystem": "^3.31"
    },
    "require-dev": {
        "cakedc/cakephp-phpstan": "^4.1",
        "cakephp/bake": "^3.6",
        "cakephp/cakephp-codesniffer": "^5.3",
        "cakephp/debug_kit": "^5.2",
        "dereuromark/cakephp-ide-helper": "^2.15",
        "josegonzalez/dotenv": "^4.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5.3 || ^12.1.3 || ^13.0"
    },
    "suggest": {
        "cakephp/repl": "Console tools for a REPL interface for CakePHP applications.",
        "markstory/asset_compress": "An asset compression plugin which provides file concatenation and a flexible filter system for preprocessing and minification."
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Test\\": "tests/",
            "Cake\\Test\\": "vendor/cakephp/cakephp/tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "cakephp/plugin-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform-check": true,
        "sort-packages": true
    },
    "scripts": {
        "post-install-cmd": "App\\Console\\Installer::postInstall",
        "post-create-project-cmd": "App\\Console\\Installer::postInstall",
        "check": [
            "@test",
            "@cs-check"
        ],
        "cs-check": "phpcs --colors -p",
        "cs-fix": "phpcbf --colors -p",
        "stan": "phpstan analyze",
        "test": "phpunit --colors=always"
    },
    "extra": {
        "plugin-paths": [
            "plugins",
            "themes"
        ]
    }
}
