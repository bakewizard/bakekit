includes:
    - vendor/cakedc/cakephp-phpstan/extension.neon
parameters:
    level: 7
    treatPhpDocTypesAsCertain: false
    bootstrapFiles:
        - config/bootstrap.php
    paths:
        - src/
    excludePaths:
        - src/Console/Installer.php
    ignoreErrors:
        - identifier: missingType.iterableValue
        - identifier: missingType.generics
